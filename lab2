def max_min_distance(positions, C):
    n = len(positions)
    
    # Counting sort - O(n) complexity
    if positions:
        max_pos = max(positions)
        min_pos = min(positions)
        range_size = max_pos - min_pos + 1
        count = [0] * range_size
        
        for pos in positions:
            count[pos - min_pos] += 1
        
        idx = 0
        for i in range(range_size):
            for _ in range(count[i]):
                positions[idx] = i + min_pos
                idx += 1

    def can_place(d):
        count = 1 
        last_pos = positions[0]

        for i in range(1, len(positions)):
            if positions[i] - last_pos >= d:
                count += 1
                last_pos = positions[i]
            if count == C:
                return True

        return False

    left, right = 0, positions[-1] - positions[0]
    best = 0

    while left <= right:
        mid = (left + right) // 2
        if can_place(mid):
            best = mid
            left = mid + 1
        else:
            right = mid - 1

    return best

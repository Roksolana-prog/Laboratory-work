class BinaryTree:
    def __init__(self, value, left=None, right=None):
        self.value = value
        self.left = left
        self.right = right

    def _diameter_helper(self, node):
        if node is None:
            return 0, -1

        left_dia, left_height = self._diameter_helper(node.left)
        right_dia, right_height = self._diameter_helper(node.right)

        current_height = 1 + max(left_height, right_height)

        current_dia = (left_height + 1) + (right_height + 1)

        max_dia = max(current_dia, left_dia, right_dia)

        return max_dia, current_height

    def binary_tree_diameter(self) -> int:
        diameter, _ = self._diameter_helper(self)
        return diameter

    @staticmethod
    def get_diameter(tree: 'BinaryTree') -> int:
        if tree is None:
            return 0
        return tree.binary_tree_diameter()


def binary_tree_diameter(tree: BinaryTree) -> int:
    if tree is None:
        return 0
    return tree.binary_tree_diameter()
